APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Game WebSocket server (legacy EGT GamePlatform bundles) — runs as the `gamesocket` compose service
GAME_SOCKET_PORT=2087
GAME_SOCKET_WORKERS=1
GAME_SOCKET_PUBLIC_HOST=localhost
GAME_SOCKET_SCHEME=ws
# GAMES_PUBLIC_URL=https://play.example.com   # base for shareable launch URLs (defaults to APP_URL)

# Legacy VanguardLTE DB — only `php artisan import:legacy` reads it (read-only).
# Point at an SSH tunnel or a local restore of the production dump.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=casino
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_PREFIX=w_
# Local mirror of the legacy server's game files. compose.yaml bind-mounts the
# host path in LEGACY_MIRROR_PATH to /var/www/legacy:ro inside the container.
# On Docker Desktop + WSL this must be a UNC path with BACKSLASHES, e.g.
#   LEGACY_MIRROR_PATH=\\wsl.localhost\Ubuntu-24.04\var\www\casino-legacy
# On a native-Linux Docker host use the plain path (/var/www/casino-legacy).
# `import:legacy --bundles` / --posters read from the in-container paths below.
LEGACY_MIRROR_PATH=\\wsl.localhost\Ubuntu-24.04\var\www\casino-legacy
LEGACY_GAMES_PATH=/var/www/legacy/gamess
LEGACY_APP_GAMES_PATH=/var/www/legacy/app-games
LEGACY_FRONTEND_PATH=/var/www/legacy/frontend
# Per-game drop used by `php artisan egt:import`
# (games-backend/<Code>, games-frontend/<Code>, games-icons/<Code>.jpg).
LEGACY_GAMES_BACKEND_PATH=/var/www/legacy/games-backend
LEGACY_GAMES_FRONTEND_PATH=/var/www/legacy/games-frontend
LEGACY_GAMES_ICONS_PATH=/var/www/legacy/games-icons
