.git
.github
.idea
.vscode
node_modules
vendor
public/build
public/hot
public/storage
# Runtime storage is a mounted volume in prod — never ship it in the image.
# (game-bundles / imported legacy assets here can be many GB and would bloat
#  the build context sent to the daemon.)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app
!storage/app/.gitignore
bootstrap/cache/*.php
.env
.env.*
!.env.production.example
*.md
Dockerfile
compose*.yaml
docker-compose*.yml
.phpunit.result.cache
.phpunit.cache
tests
